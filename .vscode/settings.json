{
  "C_Cpp.files.exclude": {
    "**/.vscode": true,
    "${workspaceFolder}/linux/**": true,
    "${workspaceFolder}/windows/**": true
  },
  "geminicodeassist.outlines.automaticOutlineGeneration": true,
  "chat.tools.terminal.autoApprove": {
    "/^flutter test test/providers/match_list_provider_test\\.dart 2>&1 \\| head -50$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter analyze$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter analyze lib/application/usecases/match_application_service\\.dart lib/presentation/operate/screens/new_match_screen\\.dart lib/presentation/operate/providers/match_generator_provider\\.dart$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter test test/integration/route_guard_test\\.dart$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter test test/widget/viewer_mode_test\\.dart$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter test 2>&1 \\| grep -i -E -B 2 -A 10 \"failed\\|exception\\|expected\\|actual\" \\| tee failed_tests\\.txt$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter test test/golden/phase2_ui_integrity_golden_test\\.dart 2>&1 \\| tee failed_tests\\.txt$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^flutter analyze lib/presentation/public/viewer/viewer_home_screen\\.dart lib/presentation/viewer/screens/viewer_bunaiksen_home_screen\\.dart lib/presentation/public/viewer/viewer_match_screen\\.dart$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^grep -R \"Total matches from provider\\\\\\|matchListProvider Web\\\\\\|Viewer Debug\" -n lib \\|\\| true$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^grep -R --line-number --exclude-dir=\\.git --exclude-dir=build --exclude-dir=coverage --exclude-dir=\\.dart_tool 'Viewer Debug' \\. \\|\\| true$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "yaml.schemas": {
    "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.yml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.fontSize": 12
}