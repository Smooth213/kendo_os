rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /organizations/{orgId} {
      allow read: if true;
      allow write, delete: if false;
    }
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write, delete: if false;
    }
    match /matches/{matchId} {
      allow read: if true;
      allow write, delete: if false;
    }
    match /viewer_sessions/{sessionId} {
      allow read: if true;
      allow write, delete: if false;
    }
  }
}
