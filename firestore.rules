rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 道場スペース配下の全セキュリティ統治ルール（テナント完全隔離＋PIN・共有トークン検証）
    match /organizations/{dojoId} {

      // ルーム存在確認・PIN設定有無確認のため単一ドキュメントgetのみ許可（一覧列挙listは禁止）
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        (isFullDojoMember() && getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner']) ||
        (resource.data.get('hasJoinPin', false) == false && request.resource.data.get('hasJoinPin', false) == true) ||
        ((isFullDojoMember() && isAdminRole() || isVerifiedDojoOwner()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rolePinPromptCompleted']))
      );

      // 内部ヘルパー関数：認証されたユーザーのロールを判定する
      function getUserRole() {
        let memberPath = /databases/$(database)/documents/organizations/$(dojoId)/members/$(request.auth.uid);
        return exists(memberPath) ? get(memberPath).data.get('role', 'none') : 'none';
      }

      function isAdminRole() {
        return getUserRole() in ['admin', 'Admin', 'owner', 'Owner'];
      }

      function isVerifiedGoogleEmail() {
        return request.auth != null &&
          request.auth.token.get('email_verified', false) == true &&
          request.auth.token.get('email', '') != '';
      }

      function isVerifiedDojoOwner() {
        let ownersPath = /databases/$(database)/documents/organizations/$(dojoId)/private/owners;
        return isVerifiedGoogleEmail() &&
          exists(ownersPath) &&
          request.auth.token.email.lower() in get(ownersPath).data.get('ownerEmails', []);
      }

      // 道場入室PINを通過した正規メンバーかどうか
      function isFullDojoMember() {
        let memberPath = /databases/$(database)/documents/organizations/$(dojoId)/members/$(request.auth.uid);
        return exists(memberPath) && get(memberPath).data.get('accessScope', 'dojo') == 'dojo';
      }

      // 1大会限定の共有リンク（share_links/{token}）で有効期限内に許可されているか
      function isScopedViewerForTournament(tournamentId) {
        let memberPath = /databases/$(database)/documents/organizations/$(dojoId)/members/$(request.auth.uid);
        let m = exists(memberPath) ? get(memberPath).data : {};
        let token = m.get('shareToken', '');
        let safeToken = token != '' ? token : '_none_';
        let sharePath = /databases/$(database)/documents/organizations/$(dojoId)/share_links/$(safeToken);
        let s = (token != '' && exists(sharePath)) ? get(sharePath).data : {};
        return m.get('accessScope', '') == 'share_link' &&
          m.get('sharedTournamentId', '') == tournamentId &&
          token != '' &&
          s.get('tournamentId', '') == tournamentId &&
          s.get('isRevoked', false) == false &&
          (s.get('expiresAt', null) == null || s.get('expiresAt', null) > request.time);
      }

      // 共有リンク経由で任意の有効な大会を閲覧中か（custom_team_names / strokes 用）
      function isAnyActiveScopedViewer() {
        let memberPath = /databases/$(database)/documents/organizations/$(dojoId)/members/$(request.auth.uid);
        let m = exists(memberPath) ? get(memberPath).data : {};
        let token = m.get('shareToken', '');
        let safeToken = token != '' ? token : '_none_';
        let sharePath = /databases/$(database)/documents/organizations/$(dojoId)/share_links/$(safeToken);
        let s = (token != '' && exists(sharePath)) ? get(sharePath).data : {};
        return m.get('accessScope', '') == 'share_link' &&
          token != '' &&
          s.get('isRevoked', false) == false &&
          (s.get('expiresAt', null) == null || s.get('expiresAt', null) > request.time);
      }

      // 自身のメンバー登録時に道場入室PIN・ロールPINまたは有効な共有トークンのハッシュ証明を検証
      function isValidMemberProof() {
        let secPath = /databases/$(database)/documents/organizations/$(dojoId)/private/security;
        let role = request.resource.data.get('role', 'viewer');
        let scope = request.resource.data.get('accessScope', 'dojo');
        let joinHash = request.resource.data.get('submittedJoinPinHash', '');
        let roleHash = request.resource.data.get('submittedRolePinHash', '');
        let token = request.resource.data.get('shareToken', '');
        let safeToken = token != '' ? token : '_none_';
        let sharedTId = request.resource.data.get('sharedTournamentId', '');
        let sharePath = /databases/$(database)/documents/organizations/$(dojoId)/share_links/$(safeToken);

        return (
          // A. 新規道場創設／レガシー道場初回PIN設定の同一バッチ書き込み
          (scope == 'dojo' && role == 'viewer' &&
            getAfter(secPath).data.joinPinHash == joinHash) ||
          // B. 既存道場への入室PINによるViewer参加
          (scope == 'dojo' && role == 'viewer' && exists(secPath) &&
            get(secPath).data.joinPinHash == joinHash) ||
          // C. 道場入室PIN＋道場別ロールPINによる特権ロール認証
          (scope == 'dojo' && role in ['admin', 'operator', 'recorder'] &&
            exists(secPath) &&
            get(secPath).data.joinPinHash == joinHash &&
            get(secPath).data.rolePinHashes[role] == roleHash) ||
          // D. 1大会限定QR/URL共有リンク（有効期限内・未停止）による限定Viewer参加
          (scope == 'share_link' && role == 'viewer' &&
            token != '' && sharedTId != '' && exists(sharePath) &&
            get(sharePath).data.get('tournamentId', '') == sharedTId &&
            get(sharePath).data.get('isRevoked', false) == false &&
            (get(sharePath).data.get('expiresAt', null) == null ||
             get(sharePath).data.get('expiresAt', null) > request.time)) ||
          // E. 登録済み代表者（Google認証＋メール確認済み）によるPIN復旧時の自己メンバー登録
          (scope == 'dojo' &&
            isVerifiedDojoOwner() &&
            getAfter(secPath).data.joinPinHash == joinHash &&
            (role == 'viewer' ||
             (role == 'admin' && getAfter(secPath).data.rolePinHashes.admin == roleHash)))
        );
      }

      // 秘密情報（PINハッシュ）：クライアントからの直接readは完全禁止（Rules内getでのみ照合）
      function canCreateSecurityDoc() {
        let secPath = /databases/$(database)/documents/organizations/$(dojoId)/private/security;
        let orgPath = /databases/$(database)/documents/organizations/$(dojoId);
        return request.auth != null && !exists(secPath) &&
          getAfter(orgPath).data.get('hasJoinPin', false) == true;
      }

      match /private/security {
        allow read: if false;
        allow create: if canCreateSecurityDoc();
        allow update: if request.auth != null && (
          (isFullDojoMember() &&
           isAdminRole() &&
           resource.data.rolePinHashes.admin == request.resource.data.get('submittedCurrentAdminPinHash', '')) ||
          isVerifiedDojoOwner()
        );
        allow delete: if false;
      }

      // Admin確認用暗号化PINボールト（Admin本人確認通過メンバーのみ読取可、Admin更新またはオーナー復旧のみ書込可）
      match /private/admin_vault {
        allow read: if request.auth != null && isFullDojoMember() && isAdminRole();
        allow create: if canCreateSecurityDoc() ||
          (request.auth != null && isFullDojoMember() && isAdminRole()) ||
          isVerifiedDojoOwner();
        allow update: if request.auth != null && (
          (isFullDojoMember() &&
           isAdminRole() &&
           get(/databases/$(database)/documents/organizations/$(dojoId)/private/security).data.rolePinHashes.admin == request.resource.data.get('submittedCurrentAdminPinHash', '')) ||
          isVerifiedDojoOwner()
        );
        allow delete: if false;
      }

      // 道場代表者（PIN復旧・引き継ぎ用Googleアカウント、最大5名）：本人またはAdminのみ参照・管理可
      match /private/owners {
        allow read: if request.auth != null && (
          (isFullDojoMember() && isAdminRole()) ||
          (isVerifiedGoogleEmail() &&
           resource != null &&
           request.auth.token.email.lower() in resource.data.get('ownerEmails', []))
        );
        allow create: if request.auth != null &&
          request.resource.data.get('ownerEmails', []).size() <= 5 &&
          (
            canCreateSecurityDoc() ||
            (isFullDojoMember() &&
             isAdminRole() &&
             get(/databases/$(database)/documents/organizations/$(dojoId)/private/security).data.rolePinHashes.admin == request.resource.data.get('submittedCurrentAdminPinHash', ''))
          );
        allow update: if request.auth != null &&
          request.resource.data.get('ownerEmails', []).size() <= 5 &&
          (
            (isFullDojoMember() &&
             isAdminRole() &&
             get(/databases/$(database)/documents/organizations/$(dojoId)/private/security).data.rolePinHashes.admin == request.resource.data.get('submittedCurrentAdminPinHash', '')) ||
            (isVerifiedGoogleEmail() &&
             request.auth.token.email.lower() in resource.data.get('ownerEmails', []))
          );
        allow delete: if false;
      }

      // 0. メンバー管理（PINまたは有効共有トークン証明を伴う自己登録、またはAdmin/Operatorによる管理）
      match /members/{userId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isFullDojoMember());
        allow create, update: if request.auth != null && (
          (request.auth.uid == userId && isValidMemberProof()) ||
          (isFullDojoMember() && getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'])
        );
        allow delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'Admin', 'owner', 'Owner'];
      }

      // 0-1. 1大会限定 観戦共有トークン（ランダムトークンを知っている場合の単一getのみ許可・list禁止）
      match /share_links/{token} {
        allow get: if request.auth != null;
        allow list: if false;
        allow create, update, delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'recorder', 'owner', 'Admin', 'Operator', 'Recorder', 'Owner'];
      }

      // 0-2. 観戦共有リンク管理メタ（運営者向け：発行済みトークンと現在プリセット保持）
      match /share_meta/{tournamentId} {
        allow read, write: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'recorder', 'owner', 'Admin', 'Operator', 'Recorder', 'Owner'];
      }

      // 1. 環境設定・組織定義
      match /settings/{document} {
        allow read: if request.auth != null && isFullDojoMember();
        allow create, update, delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'];
      }

      // 2. 選手名簿マスタ
      match /players/{playerId} {
        allow read: if request.auth != null && isFullDojoMember();
        allow create, update, delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'];
      }

      // 2-2. チーム・団体
      match /teams/{teamId} {
        allow read: if request.auth != null && isFullDojoMember();
        allow create, update, delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'];
      }

      // 2-3. カスタムチーム名（共有リンク観戦中の自チーム強調表示でも参照）
      match /custom_team_names/{docId} {
        allow read: if request.auth != null && (isFullDojoMember() || isAnyActiveScopedViewer());
        allow create, update, delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'];
      }

      // 3. 大会・リーグ設定
      match /tournaments/{tournamentId} {
        allow read: if request.auth != null && (isFullDojoMember() || isScopedViewerForTournament(tournamentId));
        allow create, update: if request.auth != null && isFullDojoMember() && (
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'] ||
          (tournamentId.matches('^bunaiksen_.*') && getUserRole() in ['recorder', 'Recorder'])
        );
        allow delete: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'];

        // 3-1. 大会プログラム (PDF/画像メタデータ)
        match /programs/{programId} {
          allow read: if request.auth != null && (isFullDojoMember() || isScopedViewerForTournament(tournamentId));
          allow create, update, delete: if request.auth != null && isFullDojoMember() &&
            getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner'];
        }

        // 4. 試合スコア・進行状態
        match /matches/{matchId} {
          allow read: if request.auth != null && (isFullDojoMember() || isScopedViewerForTournament(tournamentId));
          allow create, update, delete: if request.auth != null && isFullDojoMember() &&
            getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner', 'recorder', 'Recorder'];

          match /events/{eventChunkId} {
            allow read: if request.auth != null && (isFullDojoMember() || isScopedViewerForTournament(tournamentId));
            allow create, update, delete: if request.auth != null && isFullDojoMember() &&
              getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner', 'recorder', 'Recorder'];
          }
        }

        // 4-2. コメント（見出し）
        match /comments/{commentId} {
          allow read: if request.auth != null && (isFullDojoMember() || isScopedViewerForTournament(tournamentId));
          allow create, update, delete: if request.auth != null && isFullDojoMember() &&
            getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner', 'recorder', 'Recorder'];
        }

        // 6. 監査ログ
        match /audit_logs/{logId} {
          allow read: if request.auth != null && isFullDojoMember() && (getUserRole() in ['admin', 'Admin', 'owner', 'Owner']); // 監査ログの閲覧は管理者限定
          allow create: if request.auth != null && isFullDojoMember();
        }
      }

      // 5. プログラムへの共有手書き線データ (Strokes)
      match /strokes/{strokeId} {
        allow read: if request.auth != null && (isFullDojoMember() || isAnyActiveScopedViewer());
        allow write: if request.auth != null && isFullDojoMember() &&
          getUserRole() in ['admin', 'operator', 'owner', 'Admin', 'Operator', 'Owner', 'recorder', 'Recorder'];
      }
    }

    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.id is string
        && request.resource.data.tournamentId is string
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.type is string
        && request.resource.data.target is string
        && request.resource.data.isRead is bool;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    match /fcm_tokens/{token} {
      allow read, write: if request.auth != null;
    }

    match /fcm_config/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 👤 個人領域（クイックメモ・通知既読等）: 本人のみ完全読み書き可能
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /client_logs/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // =========================================================================
    // 🚫 絶対防壁: 旧仕様・ルート階層・横断クエリへの無制限アクセスを完全遮断
    // =========================================================================
    match /{path=**}/matches/{matchId} { allow read: if false; }
    match /audit_logs/{document=**} { allow read, write: if false; }
    match /auditLogs/{document=**} { allow read, write: if false; }
    match /teams/{document=**} { allow read, write: if false; }
    match /tournaments/{document=**} { allow read, write: if false; }
    match /programs/{document=**} { allow read, write: if false; }
    match /players/{document=**} { allow read, write: if false; }
    match /custom_team_names/{document=**} { allow read, write: if false; }
    match /strokes/{document=**} { allow read, write: if false; }
  }
}
